{
  "name": "stackr",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "api": "json-server --watch db/db.json --port 3001"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "bcryptjs": "^3.0.3",
    "tailwindcss": "^4.1.18",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.3",
    "json-server": "^1.0.0-beta.15",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
